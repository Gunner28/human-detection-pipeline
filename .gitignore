# Model weights — fetched by scripts/download_models.sh, or auto-downloaded
models/frozen_inference_graph.pb
models/*.tar.gz
*.pt
*.onnx

# Sample footage and rendered output — large binaries, not source
samples/*.mp4
samples/*.mov
outputs/*.mp4
outputs/*.avi
outputs/*.pkl

# MOT17 benchmark data — 5.6 GB, redownloadable from motchallenge.net.
# Never committed; scripts/verify_mot17.py checks a local copy is intact.
MOT17/
MOT17.zip

# Working images from evaluation runs. The two figures referenced by the
# README are force-added; everything else here is scratch.
outputs/eval_frames/
outputs/label_frames/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store

# TrackEval — cloned and patched by scripts/setup_trackeval.sh, pinned there.
external/TrackEval/

# Benchmark results. Regenerated by scripts/run_mot17.py + eval_mot17.py;
# the headline numbers live in docs/, not as committed CSVs.
outputs/mot17/
outputs/mot17_eval/
